# 이 파일을 복사해 .env 를 만들고 값을 채운다.
#   cp .env.example .env
#
# .env 는 .gitignore 에 있어 절대 커밋되지 않는다. 커밋하려 하면 훅이 막는다.
# 값은 사람이 직접 편집기로 넣는다. 채팅창이나 명령줄에 붙여넣지 않는다.
# 명령줄에 쓰면 셸 히스토리에 남는다.

# 공공데이터포털 일반 인증키 (Decoding). data.go.kr 마이페이지 > 오픈API > 개발계정
DATA_GO_KR_KEY=

# 요청 주소가 기본값과 다를 때만 채운다. 보통 비워 둔다.
DATA_GO_KR_ENDPOINT=
