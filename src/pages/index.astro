---
import Base from '../layouts/Base.astro';
import { SITE, TARGETS } from '../lib/site.mjs';
import { publishedServices } from '../lib/published.mjs';
import { targetName } from '../lib/data.mjs';

const all = await publishedServices();
const open = all.filter((s) => s.open);

// 한 제도가 여러 대상을 지원하면 targets 에 그 대상이 전부 들어간다. 허브에서는 맞지만
// 홈에서 그대로 쓰면 같은 문서가 섹션마다 반복돼 화면이 중복 덩어리가 된다.
// 홈에서는 제도마다 한 번씩만, 대상 수가 적은 쪽(= 더 특정한 대상)에 배치한다.
const shown = new Set();
const byTarget = TARGETS.map((t) => {
  const items = open
    .filter((s) => s.targets.includes(t.slug) && !shown.has(s.id))
    .sort((a, b) => a.targets.length - b.targets.length)
    .slice(0, 6);
  items.forEach((s) => shown.add(s.id));
  // 해당 대상의 전체 건수는 '전체 보기' 링크 노출 판단에 쓴다.
  return { ...t, items, total: open.filter((s) => s.targets.includes(t.slug)).length };
}).filter((t) => t.items.length > 0);

// 대상 분류가 비어 있는 제도가 있다. '돌봄이 필요한 도민 누구나' 처럼 원문이
// 특정 계층을 지목하지 않으면 targetsOf() 가 빈 배열을 낸다. 분류가 틀린 게 아니다.
// 다만 홈이 대상군으로만 묶여 있어서 이런 문서는 어느 섹션에도 실리지 않는다.
// 지역 허브도 5건 미만이면 안 만들므로, 사이트맵 말고는 들어갈 길이 없는 고아가 된다.
// 새 URL 을 만들지 않고 홈에 섹션 하나로 받는다.
const unlisted = open.filter((s) => s.targets.length === 0);
---

<Base>
  <h1>{SITE.name}</h1>
  <p class="lede">{SITE.description}</p>

  {all.length === 0 && (
    <p class="disclaimer">
      아직 발행된 지원금 문서가 없습니다. <code>npm run sync</code> 로 공공데이터를 받고,
      해설 문서를 작성하면 이곳에 표시됩니다.
    </p>
  )}

  {byTarget.map((t) => (
    <>
      <h2>{t.name} 지원금</h2>
      <ul class="cards">
        {t.items.map((s) => (
          <li>
            <a href={`/s/${s.id}/`}>{s.name}</a>
            <p>{s.description}</p>
          </li>
        ))}
      </ul>
      {t.total > t.items.length && (
        <p><a href={`/target/${t.slug}/`}>{t.name} 지원금 전체 보기 ({t.total}건)</a></p>
      )}
    </>
  ))}

  {unlisted.length > 0 && (
    <>
      <h2>대상을 가리지 않는 지원금</h2>
      <ul class="cards">
        {unlisted.map((s) => (
          <li>
            <a href={`/s/${s.id}/`}>{s.name}</a>
            <p>{s.description}</p>
          </li>
        ))}
      </ul>
    </>
  )}

  <h2>이 사이트를 만드는 방식</h2>
  <p>
    정부와 지자체가 공공데이터포털에 공개한 공공서비스 정보를 매일 내려받아 정리합니다.
    각 문서는 원문 공고와 대조해 금액·자격·기간이 일치하는지 확인한 뒤에만 공개하며,
    모든 페이지에 출처 링크와 데이터 기준일을 표시합니다. 확인되지 않은 내용은 적지 않고
    «공고 확인»으로 남겨둡니다.
  </p>
  <p><a href="/about/">사이트 소개와 편집 원칙 자세히 보기</a></p>
</Base>
